{
  "name": "yt-downloader",
  "version": "1.0.7",
  "description": "Windows YouTube Downloader built with Electron and React",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "electron:dev": "electron . --dev",
    "package": "electron-builder --publish never"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.2.1"
  },
  "build": {
    "appId": "com.gloooomed.ytd",
    "productName": "YT Downloader",
    "asar": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "bridge.py",
      "src/yt_downloader/**",
      "dist-react/**"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "YT-Downloader-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "YT Downloader"
    }
  }
}
